# Copie este arquivo para .env e preencha com seus valores reais
# O arquivo .env nunca deve ser commitado no Git

DB_URL=jdbc:postgresql://127.0.0.1:5432/mecanix_db
DB_USERNAME=postgres
DB_PASSWORD=sua_senha_aqui

MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_app_password_aqui

# Nome exibido como remetente no e-mail da OS (ex.: nome da oficina)
MAIL_NOME=Oficina MECANIX

# Chave secreta pra criptografar dados sensíveis no banco (hoje, a senha de
# app de e-mail que cada oficina pode cadastrar no próprio perfil). Gere algo
# longo e aleatório e NUNCA reaproveite o valor de exemplo em produção.
CRYPTO_SECRET=troque-por-uma-string-aleatoria-longa
