{
  "permissions": {
    "allow": [
      "Bash(curl -s http://localhost:8080/api/auth/login -X POST -H \"Content-Type: application/json\" -d '{\"email\":\"admin@mecanix.com\",\"senha\":\"admin123\"}' -c /tmp/cf.txt)",
      "Bash(curl -s -X POST http://localhost:8080/api/auth/login -H \"Content-Type: application/json\" -d '{}')",
