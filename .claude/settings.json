      "Bash(curl -s -b /tmp/cf.txt http://localhost:8080/api/auth/me)",
      "Bash(curl -s -b /tmp/cf.txt -X POST http://localhost:8080/api/clientes -H \"Content-Type: application/json\" -d '{\"nome\":\"Carlos\",\"cpf\":\"abc\"}')",
      "Bash(curl -s -b /tmp/cf.txt -X POST http://localhost:8080/api/estoque -H \"Content-Type: application/json\" -d '{\"nome\":\"Filtro\",\"quantidade\":5}')"
